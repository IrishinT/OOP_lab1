<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- общие стили -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="Heading1Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="Heading2Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="Heading3Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <!-- контейнеры и поля ввода -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="RowBackground" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <!-- стили кнопок -->
    <Style x:Key="BaseColoredButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseColoredButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Primary500Brush}"/>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseColoredButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Accent500Brush}"/>
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseColoredButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Success500Brush}"/>
    </Style>

    <Style x:Key="ErrorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseColoredButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Error500Brush}"/>
    </Style>

    <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseColoredButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Info500Brush}"/>
    </Style>

    <!-- стили для ToggleButton -->
    <Style x:Key="BaseColoredToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PrimaryToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseColoredToggleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Primary500Brush}"/>
    </Style>

    <Style x:Key="AccentToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseColoredToggleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Accent500Brush}"/>
    </Style>

    <Style x:Key="SuccessToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseColoredToggleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Success500Brush}"/>
    </Style>

    <Style x:Key="ErrorToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseColoredToggleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Error500Brush}"/>
    </Style>

    <Style x:Key="InfoToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseColoredToggleButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Info500Brush}"/>
    </Style>

    <!-- стили для ProgressBar -->
    <Style x:Key="BaseProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style x:Key="PrimaryProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Foreground" Value="{StaticResource Primary500Brush}"/>
    </Style>

    <Style x:Key="AccentProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Foreground" Value="{StaticResource Accent500Brush}"/>
    </Style>

    <Style x:Key="SuccessProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Foreground" Value="{StaticResource Success500Brush}"/>
    </Style>

    <Style x:Key="ErrorProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Foreground" Value="{StaticResource Error500Brush}"/>
    </Style>

    <Style x:Key="InfoProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Foreground" Value="{StaticResource Info500Brush}"/>
    </Style>

</ResourceDictionary>