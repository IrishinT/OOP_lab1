                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary700Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#303F9F" Width="90"/>
                                    <TextBlock Text="Primary 700"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary800Brush}" Margin="0,0,5,0"/>
