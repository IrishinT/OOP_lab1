<Window x:Class="OOP_lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOP_lab1"
        mc:Ignorable="d"
        Title="Настройки приложения" Height="680" Width="1050"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{Binding SelectedFontFamily}"
        FontSize="{Binding SelectedFontSize}">

    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   Background="{DynamicResource SurfaceBackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="Основное">
                <StackPanel Margin="10">
                    <GroupBox Header="Персонализация" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Тема интерфейса:" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Margin="0,0,0,15"/>

                            <TextBlock Text="Язык интерфейса:" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Настройки шрифтов" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Шрифт:" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding FontFamilies}"
                                      SelectedItem="{Binding SelectedFontFamily}"
                                      Margin="0,0,0,15"/>

                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="Размер шрифта: "/>
                                <TextBlock Text="{Binding SelectedFontSize, StringFormat={}{0:0} pt}" Margin="0,0,15,0"/>

                                <Slider x:Name="FontSlider"
                                        Minimum="10"
                                        Maximum="24"
                                        Value="{Binding SelectedFontSize, Mode=TwoWay}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <Button Content="Сбросить настройки по умолчанию"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ResetSettingsCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Цветовая палитра">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Margin="0,0,0,10">
                            <Run Text="Текущая тема: "/>
                            <Run Text="{Binding SelectedTheme}" FontWeight="Bold"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <GroupBox Header="Основные цвета" Padding="10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="100" Height="40" Fill="{StaticResource Primary500Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Основной" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Rectangle Width="100" Height="40" Fill="{StaticResource Accent500Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Акцентный" VerticalAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Индикаторные цвета" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="100" Height="40" Fill="{StaticResource Success500Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Успех" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Rectangle Width="100" Height="40" Fill="{StaticResource Error500Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Ошибка" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Rectangle Width="100" Height="40" Fill="{StaticResource Info500Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Информация" VerticalAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <GroupBox Header="Оттенки: Основной" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary50Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#E8EAF6" Width="90"/>
                                    <TextBlock Text="Primary 50"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary100Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#C5CAE9" Width="90"/>
                                    <TextBlock Text="Primary 100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary200Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#9FA8DA" Width="90"/>
                                    <TextBlock Text="Primary 200"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary300Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#7986CB" Width="90"/>
                                    <TextBlock Text="Primary 300"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary400Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#5C6BC0" Width="90"/>
                                    <TextBlock Text="Primary 400"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary500Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#3F51B5" Width="90"/>
                                    <TextBlock Text="Primary 500"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary600Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#3949AB" Width="90"/>
                                    <TextBlock Text="Primary 600"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary700Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#303F9F" Width="90"/>
                                    <TextBlock Text="Primary 700"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary800Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#283593" Width="90"/>
                                    <TextBlock Text="Primary 800"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Primary900Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#1A237E" Width="90"/>
                                    <TextBlock Text="Primary 900"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Оттенки: Акцентный" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Accent50Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#FFF3E0" Width="90"/>
                                    <TextBlock Text="Accent 50"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Accent100Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#FFE0B2" Width="90"/>
                                    <TextBlock Text="Accent 100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Accent200Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#FFCC80" Width="90"/>
