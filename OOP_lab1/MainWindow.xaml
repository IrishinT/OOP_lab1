                                    <Button Content="Кнопка" Background="#F44336" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="✔" Background="#F44336" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Background="#F44336" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Background="#F44336" Foreground="White" Padding="8,4" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Информация:" FontWeight="Bold"/>
