                                    <Button Content="Кнопка" Background="#03A9F4" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="✔" Background="#03A9F4" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Background="#03A9F4" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Background="#03A9F4" Foreground="White" Padding="8,4" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ListBox, ComboBox, TextBox, PasswordBox, RichTextBox" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ListBox"/>
                                    <ListBox Height="80">
                                        <ListBoxItem Content="Элемент 1" IsSelected="True"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                        <ListBoxItem Content="Неактивный" IsEnabled="False"/>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ComboBox"/>
                                    <ComboBox SelectedIndex="0" Margin="0,0,0,5">
                                        <ComboBoxItem Content="Вариант 1"/>
                                        <ComboBoxItem Content="Вариант 2"/>
                                    </ComboBox>
                                    <ComboBox SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="Неактивный"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="TextBox"/>
                                    <TextBox Text="Обычный" Margin="0,0,0,5"/>
                                    <TextBox Text="Неактивный" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="PasswordBox"/>
                                    <PasswordBox Password="12345" Margin="0,0,0,5"/>
                                    <PasswordBox Password="12345" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Width="200">
                                    <TextBlock Text="RichTextBox"/>
                                    <RichTextBox Height="80">
                                        <FlowDocument>
                                            <Paragraph>
                                                <Bold>Жирный</Bold> и
                                                <Italic>курсив</Italic> текст.
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TextBlock, Label" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="TextBlock:" Foreground="Gray"/>
                                    <TextBlock Text="Заголовок 1" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="Заголовок 2" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Заголовок 3" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Обычный текст" FontSize="14"/>
                                    <TextBlock Text="Подпись" FontSize="11" FontStyle="Italic" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="Label:" Foreground="Gray"/>
                                    <Label Content="Заголовок 1" FontSize="28" FontWeight="Bold"/>
                                    <Label Content="Заголовок 2" FontSize="22" FontWeight="Bold"/>
                                    <Label Content="Заголовок 3" FontSize="18" FontWeight="Bold"/>
                                    <Label Content="Обычный текст" FontSize="14"/>
                                    <Label Content="Подпись" FontSize="11" FontStyle="Italic" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
