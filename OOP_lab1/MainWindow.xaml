                                    <TextBlock Text="#43A047" Width="90"/>
                                    <TextBlock Text="Success 600"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Success700Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#388E3C" Width="90"/>
                                    <TextBlock Text="Success 700"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Success800Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#2E7D32" Width="90"/>
                                    <TextBlock Text="Success 800"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Success900Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#1B5E20" Width="90"/>
                                    <TextBlock Text="Success 900"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Tr Loc_ShadesError}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error50Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#FFEBEE" Width="90"/>
                                    <TextBlock Text="Error 50"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error100Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#FFCDD2" Width="90"/>
                                    <TextBlock Text="Error 100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error200Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#EF9A9A" Width="90"/>
                                    <TextBlock Text="Error 200"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error300Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#E57373" Width="90"/>
                                    <TextBlock Text="Error 300"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error400Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#EF5350" Width="90"/>
                                    <TextBlock Text="Error 400"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error500Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#F44336" Width="90"/>
                                    <TextBlock Text="Error 500"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error600Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#E53935" Width="90"/>
                                    <TextBlock Text="Error 600"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error700Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#D32F2F" Width="90"/>
                                    <TextBlock Text="Error 700"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error800Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#C62828" Width="90"/>
                                    <TextBlock Text="Error 800"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Error900Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#B71C1C" Width="90"/>
                                    <TextBlock Text="Error 900"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Tr Loc_ShadesInfo}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info50Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#E1F5FE" Width="90"/>
                                    <TextBlock Text="Info 50"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info100Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#B3E5FC" Width="90"/>
                                    <TextBlock Text="Info 100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info200Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#81D4FA" Width="90"/>
                                    <TextBlock Text="Info 200"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info300Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#4FC3F7" Width="90"/>
                                    <TextBlock Text="Info 300"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info400Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#29B6F6" Width="90"/>
                                    <TextBlock Text="Info 400"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info500Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#03A9F4" Width="90"/>
                                    <TextBlock Text="Info 500"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info600Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#039BE5" Width="90"/>
                                    <TextBlock Text="Info 600"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info700Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#0288D1" Width="90"/>
                                    <TextBlock Text="Info 700"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Info800Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#0277BD" Width="90"/>
                                    <TextBlock Text="Info 800"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
