                                    <ToggleButton Content="Переключатель" Background="#4CAF50" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Background="#4CAF50" Foreground="White" Padding="8,4" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Ошибка:" FontWeight="Bold"/>
