                            <StackPanel Margin="10">
                                <TextBlock Text="Основной:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Кнопка" Background="#3F51B5" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="✔" Background="#3F51B5" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Background="#3F51B5" Foreground="White" Padding="8,4" Margin="0,0,5,0"/>
