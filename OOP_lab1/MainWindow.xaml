                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Tr Loc_TabControls}">
                <ScrollViewer>
                    <StackPanel Margin="10">

                        <Expander Header="{Tr Loc_ExpButtons}" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Tr Loc_PrimaryColon}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Primary" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Primary ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{Tr Loc_ToggleText}" Style="{StaticResource PrimaryToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="{Tr Loc_AccentColon}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Accent" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource AccentButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Accent ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{Tr Loc_ToggleText}" Style="{StaticResource AccentToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="{Tr Loc_SuccessColon}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Success" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Success ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{Tr Loc_ToggleText}" Style="{StaticResource SuccessToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource SuccessButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="{Tr Loc_ErrorColon}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource ErrorButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Error" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource ErrorButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Error ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{Tr Loc_ToggleText}" Style="{StaticResource ErrorToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource ErrorButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="{Tr Loc_InfoColon}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource InfoButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Info" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource InfoButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Info ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{Tr Loc_ToggleText}" Style="{StaticResource InfoToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="{Tr Loc_BtnText}" Style="{StaticResource InfoButtonStyle}" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ListBox, ComboBox, TextBox, PasswordBox, RichTextBox" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ListBox"/>
                                    <ListBox Height="80">
                                        <ListBoxItem Content="{Tr Loc_ListItem1}" IsSelected="True"/>
                                        <ListBoxItem Content="{Tr Loc_ListItem2}"/>
                                        <ListBoxItem Content="{Tr Loc_DisabledItem}" IsEnabled="False"/>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ComboBox"/>
                                    <ComboBox SelectedIndex="0" Margin="0,0,0,5">
                                        <ComboBoxItem Content="{Tr Loc_Option1}"/>
                                        <ComboBoxItem Content="{Tr Loc_Option2}"/>
                                    </ComboBox>
                                    <ComboBox SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="{Tr Loc_DisabledItem}"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="TextBox"/>
                                    <TextBox Tag="{Tr Loc_NormalText}" Margin="0,0,0,5"
                                             Text="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}"/>
                                    <TextBox Tag="{Tr Loc_DisabledItem}" IsEnabled="False"
                                             Text="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="PasswordBox"/>
                                    <PasswordBox Password="12345" Margin="0,0,0,5"/>
                                    <PasswordBox Password="12345" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Width="200">
                                    <TextBlock Text="RichTextBox"/>
                                    <RichTextBox Height="80">
                                        <FlowDocument>
                                            <Paragraph>
                                                <Bold>Bold</Bold> /
                                                <Italic>Italic</Italic>
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TextBlock, Label" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="TextBlock:" Style="{StaticResource CaptionTextStyle}"/>
                                    <TextBlock Text="{Tr Loc_Heading1}" Style="{StaticResource Heading1Style}"/>
                                    <TextBlock Text="{Tr Loc_Heading2}" Style="{StaticResource Heading2Style}"/>
                                    <TextBlock Text="{Tr Loc_Heading3}" Style="{StaticResource Heading3Style}"/>
                                    <TextBlock Text="{Tr Loc_BodyText}"/>
                                    <TextBlock Text="{Tr Loc_CaptionText}" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="Label:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <Label Content="{Tr Loc_Heading1}" FontSize="28" FontWeight="Bold"/>
                                    <Label Content="{Tr Loc_Heading2}" FontSize="22" FontWeight="Bold"/>
                                    <Label Content="{Tr Loc_Heading3}" FontSize="18" FontWeight="Bold"/>
                                    <Label Content="{Tr Loc_BodyText}"/>
                                    <Label Content="{Tr Loc_CaptionText}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TreeView" Margin="0,0,0,5">
                            <TreeView Margin="10" Height="120">
                                <TreeViewItem Header="{Tr Loc_TreeDocs}" IsExpanded="True">
                                    <TreeViewItem Header="Report.docx"/>
                                    <TreeViewItem Header="Lab1.pdf"/>
                                </TreeViewItem>
                                <TreeViewItem Header="{Tr Loc_TreeImages}">
                                    <TreeViewItem Header="photo.png"/>
                                </TreeViewItem>
                            </TreeView>
                        </Expander>

                        <Expander Header="{Tr Loc_ExpDataGrid}" IsExpanded="True" Margin="0,0,0,5"
                                  PreviewKeyDown="StudentData_PreviewKeyDown">
                            <Expander.Resources>
                                <Style x:Key="StudentGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Primary500Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Resources>
                            <StackPanel Margin="10">
                                <ToolBarTray Margin="0,0,0,10">
                                    <ToolBar Margin="0,0,0,10">
                                        <Button Content="{Tr Loc_Copy}"
                                            Style="{StaticResource InfoButtonStyle}"
                                            Command="{Binding CopyStudentsCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=StudentsGrid}"
                                            ToolTip="Ctrl+C"
                                            Margin="0,0,6,0"/>
                                        <Button Content="{Tr Loc_Paste, {Binding ActiveTableNumber}}"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            Command="{Binding PasteStudentsCommand}"
                                            CommandParameter="{Binding ActiveTableNumber}"
                                            ToolTip="Ctrl+V"/>
                                    </ToolBar>
                                </ToolBarTray>

                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Width="160" Margin="0,0,10,5">
                                        <TextBlock Text="{Tr Loc_ColLastNameColon}"/>
                                        <TextBox Text="{Binding InputLastName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,10,5">
                                        <TextBlock Text="{Tr Loc_ColGroupColon}"/>
                                        <TextBox Text="{Binding InputGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="90" Margin="0,0,15,5">
                                        <TextBlock Text="{Tr Loc_ColGradeRange}"/>
                                        <TextBox Text="{Binding InputGrade, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                        <Button Content="{Tr Loc_Add}"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                Command="{Binding AddStudentCommand}"
                                                Margin="0,0,5,0"/>
                                        <Button Content="{Tr Loc_Edit}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding EditStudentCommand}"
                                                Margin="0,0,5,0"/>
                                        <Button Content="{Tr Loc_Delete}"
                                                Style="{StaticResource ErrorButtonStyle}"
                                                Command="{Binding DeleteStudentsCommand}"
                                                CommandParameter="{Binding SelectedItems, ElementName=StudentsGrid}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Tr Loc_Table1Title}" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <DataGrid x:Name="StudentsGrid"
                                                  Style="{StaticResource StudentGridStyle}"
                                                  ItemsSource="{Binding Students}"
                                                  SelectedItem="{Binding SelectedStudent}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow"
                                                  PreviewKeyDown="StudentsGrid_PreviewKeyDown"
                                                  PreviewMouseLeftButtonDown="StudentsGrid_PreviewMouseLeftButtonDown"
                                                  GotKeyboardFocus="StudentsGrid_GotKeyboardFocus"
                                                  Height="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColLastName}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColGroup}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Grade, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColGrade}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Tr Loc_Table2Title}" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <DataGrid x:Name="SecondStudentsGrid"
                                                  Style="{StaticResource StudentGridStyle}"
                                                  ItemsSource="{Binding SecondStudents}"
                                                  SelectedItem="{Binding SelectedSecondStudent}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow"
                                                  PreviewKeyDown="StudentsGrid_PreviewKeyDown"
                                                  PreviewMouseLeftButtonDown="StudentsGrid_PreviewMouseLeftButtonDown"
                                                  GotKeyboardFocus="StudentsGrid_GotKeyboardFocus"
                                                  Height="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding LastName}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColLastName}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Group}" Width="*">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColGroup}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Grade}" Width="80">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{Tr Loc_ColGrade}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ProgressBar" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <ProgressBar Value="20" Style="{StaticResource PrimaryProgressBarStyle}"/>
                                <ProgressBar Value="40" Style="{StaticResource AccentProgressBarStyle}"/>
                                <ProgressBar Value="100" Style="{StaticResource SuccessProgressBarStyle}"/>
                                <ProgressBar Value="60" Style="{StaticResource ErrorProgressBarStyle}"/>
                                <ProgressBar Value="80" Style="{StaticResource InfoProgressBarStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Tr Loc_ExpTooltips}" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Button Content="{Tr Loc_HoverMe}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                                        ToolTip="{Tr Loc_TooltipSimple}"/>
                                <TextBox Width="150" Tag="{Tr Loc_InputField}"
                                         Text="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                         ToolTip="{Tr Loc_TooltipInput}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Tr Loc_ExpMenus}" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <Menu>
                                    <MenuItem Header="{Tr Loc_MenuFile}">
                                        <MenuItem Header="{Tr Loc_MenuNew}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Loc_MenuNew"/>
                                        <MenuItem Header="{Tr Loc_MenuOpen}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Loc_MenuOpen"/>
                                        <Separator/>
                                        <MenuItem Header="{Tr Loc_MenuExit}" Command="{Binding ExitCommand}"/>
                                    </MenuItem>
                                    <MenuItem Header="{Tr Loc_MenuEdit}">
                                        <MenuItem Header="{Tr Loc_MenuCopyRow}" Command="{Binding CopyStudentsCommand}"
                                                  CommandParameter="{Binding SelectedItems, ElementName=StudentsGrid}"/>
                                        <MenuItem Header="{Tr Loc_Paste, {Binding ActiveTableNumber}}" Command="{Binding PasteStudentsCommand}"
                                                  CommandParameter="{Binding ActiveTableNumber}"/>
                                    </MenuItem>
                                </Menu>

                                <Border Height="60" Margin="0,10,0,0" Background="{StaticResource Info500Brush}"
                                        Tag="{Binding SelectedItems, ElementName=StudentsGrid}">
                                    <TextBlock Text="{Tr Loc_RightClickHint}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Tr Loc_MenuCopyRow}" Command="{Binding CopyStudentsCommand}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{Tr Loc_Paste, {Binding ActiveTableNumber}}" Command="{Binding PasteStudentsCommand}"
                                                      CommandParameter="{Binding ActiveTableNumber}"/>
                                            <MenuItem Header="{Tr Loc_MenuDeleteRow}" Command="{Binding DeleteStudentsCommand}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Tr Loc_TabContainers}">
                <ScrollViewer>
                    <WrapPanel Margin="10">
                        <GroupBox Header="StackPanel" Width="250" Height="200" Margin="5">
                            <StackPanel>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="WrapPanel" Width="250" Height="200" Margin="5">
                            <WrapPanel>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Error500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Info500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="DockPanel" Width="250" Height="200" Margin="5">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Top" Height="30" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle DockPanel.Dock="Bottom" Height="30" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle DockPanel.Dock="Left" Width="40" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Grid" Width="250" Height="200" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="UniformGrid" Width="250" Height="200" Margin="5">
                            <UniformGrid Rows="2" Columns="2">
                                <Rectangle Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="Canvas" Width="250" Height="200" Margin="5">
                            <Canvas>
                                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="80" Height="50" Fill="{StaticResource Primary500Brush}"/>
                                <Rectangle Canvas.Left="50" Canvas.Top="50" Width="80" Height="50" Fill="{StaticResource Accent500Brush}"/>
                                <Rectangle Canvas.Left="90" Canvas.Top="90" Width="80" Height="50" Fill="{StaticResource Success500Brush}"/>
                            </Canvas>
                        </GroupBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Tr Loc_TabBindings}">
                <ScrollViewer>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="{Tr Loc_BindingModes}" Padding="12">
                            <StackPanel>
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{Tr Loc_BindingSource}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding BindingModeText}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Margin="0,4,0,8"/>
                                        <Button Content="{Tr Loc_BindingChange}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ChangeBindingTextCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Tr Loc_OneWay}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BindingModeText, Mode=OneWay}" Margin="0,3,0,4"/>
                                <TextBlock Text="{Tr Loc_OneWayHelp}"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

                                <TextBlock Text="{Tr Loc_TwoWay}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BindingModeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,4"/>
                                <TextBlock Text="{Tr Loc_TwoWayHelp}"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

                                <TextBlock Text="{Tr Loc_OneTime}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BindingModeText, Mode=OneTime}" Margin="0,3,0,4"/>
                                <TextBlock Text="{Tr Loc_OneTimeHelp}"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

                                <TextBlock Text="{Tr Loc_OneWayToSource}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BindingModeText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,4"/>
                                <TextBlock Text="{Tr Loc_OneWayToSourceHelp}"
                                           Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="{Tr Loc_UpdateTriggers}" Padding="12">
                            <StackPanel>
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{Tr Loc_BindingSource}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding TriggerDemoText}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Tr Loc_TriggerPropertyChanged}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding TriggerDemoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12"/>

                                <TextBlock Text="{Tr Loc_TriggerLostFocus}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding TriggerDemoText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,12"/>

                                <TextBlock Text="{Tr Loc_TriggerExplicit}" FontWeight="SemiBold"/>
                                <DockPanel Margin="0,3,0,12">
                                    <Button DockPanel.Dock="Right"
                                            Content="{Tr Loc_TriggerUpdate}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ExplicitUpdate_Click"
                                            Margin="8,0,0,0"/>
                                    <TextBox x:Name="ExplicitBox"
                                             Text="{Binding TriggerDemoText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                                </DockPanel>

                                <TextBlock Text="{Tr Loc_TriggerDefault}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding TriggerDemoText, Mode=TwoWay, UpdateSourceTrigger=Default}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
