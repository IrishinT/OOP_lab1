                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Элементы управления">
                <ScrollViewer>
                    <StackPanel Margin="10">

                        <Expander Header="Кнопки" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <TextBlock Text="Основной:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Кнопка" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Основной" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Основной ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Style="{StaticResource PrimaryToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Акцентный:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Кнопка" Style="{StaticResource AccentButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Акцентный" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource AccentButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Акцентный ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Style="{StaticResource AccentToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Успех:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Кнопка" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Успех" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Успех ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Style="{StaticResource SuccessToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Style="{StaticResource SuccessButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Ошибка:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Кнопка" Style="{StaticResource ErrorButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Ошибка" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource ErrorButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Ошибка ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Style="{StaticResource ErrorToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Style="{StaticResource ErrorButtonStyle}" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Text="Информация:" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Кнопка" Style="{StaticResource InfoButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Информация" Margin="0,0,5,0"/>
                                    <Button Content="✔" Style="{StaticResource InfoButtonStyle}" Command="{Binding ShowActionMessageCommand}" CommandParameter="Информация ✔" Margin="0,0,5,0"/>
                                    <ToggleButton Content="Переключатель" Style="{StaticResource InfoToggleButtonStyle}" Margin="0,0,5,0"/>
                                    <Button Content="Кнопка" Style="{StaticResource InfoButtonStyle}" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ListBox, ComboBox, TextBox, PasswordBox, RichTextBox" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ListBox"/>
                                    <ListBox Height="80">
                                        <ListBoxItem Content="Элемент 1" IsSelected="True"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                        <ListBoxItem Content="Неактивный" IsEnabled="False"/>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="ComboBox"/>
                                    <ComboBox SelectedIndex="0" Margin="0,0,0,5">
                                        <ComboBoxItem Content="Вариант 1"/>
                                        <ComboBoxItem Content="Вариант 2"/>
                                    </ComboBox>
                                    <ComboBox SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="Неактивный"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="TextBox"/>
                                    <TextBox Text="Обычный" Margin="0,0,0,5"/>
                                    <TextBox Text="Неактивный" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Width="150" Margin="0,0,15,0">
                                    <TextBlock Text="PasswordBox"/>
                                    <PasswordBox Password="12345" Margin="0,0,0,5"/>
                                    <PasswordBox Password="12345" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Width="200">
                                    <TextBlock Text="RichTextBox"/>
                                    <RichTextBox Height="80">
                                        <FlowDocument>
                                            <Paragraph>
                                                <Bold>Жирный</Bold> и
                                                <Italic>курсив</Italic> текст.
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TextBlock, Label" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="TextBlock:" Style="{StaticResource CaptionTextStyle}"/>
                                    <TextBlock Text="Заголовок 1" Style="{StaticResource Heading1Style}"/>
                                    <TextBlock Text="Заголовок 2" Style="{StaticResource Heading2Style}"/>
                                    <TextBlock Text="Заголовок 3" Style="{StaticResource Heading3Style}"/>
                                    <TextBlock Text="Обычный текст"/>
                                    <TextBlock Text="Подпись" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label Content="Label:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <Label Content="Заголовок 1" FontSize="28" FontWeight="Bold"/>
                                    <Label Content="Заголовок 2" FontSize="22" FontWeight="Bold"/>
                                    <Label Content="Заголовок 3" FontSize="18" FontWeight="Bold"/>
                                    <Label Content="Обычный текст"/>
                                    <Label Content="Подпись" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TreeView" Margin="0,0,0,5">
                            <TreeView Margin="10" Height="120">
                                <TreeViewItem Header="Документы" IsExpanded="True">
                                    <TreeViewItem Header="Отчёт.docx"/>
                                    <TreeViewItem Header="Лаб1.pdf"/>
                                </TreeViewItem>
                                <TreeViewItem Header="Изображения">
                                    <TreeViewItem Header="photo.png"/>
                                </TreeViewItem>
                            </TreeView>
                        </Expander>

                        <Expander Header="DataGrid (CRUD и копирование между таблицами)" IsExpanded="True" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <ToolBarTray Margin="0,0,0,10">
                                    <ToolBar>
                                        <Button Content="📋 Копировать (из Таблицы 1)"
                                                Command="{Binding CopyStudentCommand}"
                                                Padding="8,4"/>
                                        <Button Content="📥 Вставить (в Таблицу 2)"
                                                Command="{Binding PasteStudentCommand}"
                                                Padding="8,4"/>
                                        <Separator/>
                                        <Button Content="🗑 Удалить из Таблицы 2"
                                                Command="{Binding DeleteSecondStudentCommand}"
                                                Padding="8,4"/>
                                    </ToolBar>
                                </ToolBarTray>

                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Width="160" Margin="0,0,10,5">
                                        <TextBlock Text="Фамилия:"/>
                                        <TextBox Text="{Binding InputLastName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,10,5">
                                        <TextBlock Text="Группа:"/>
                                        <TextBox Text="{Binding InputGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="80" Margin="0,0,15,5">
                                        <TextBlock Text="Оценка (1-10):"/>
                                        <TextBox Text="{Binding InputGrade, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                        <Button Content="Добавить"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                Command="{Binding AddStudentCommand}"
                                                Margin="0,0,5,0"/>
                                        <Button Content="Изменить"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding EditStudentCommand}"
                                                Margin="0,0,5,0"/>
                                        <Button Content="Удалить"
                                                Style="{StaticResource ErrorButtonStyle}"
                                                Command="{Binding DeleteStudentCommand}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Таблица 1 (основная — можно редактировать):" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <DataGrid ItemsSource="{Binding Students}"
                                                  SelectedItem="{Binding SelectedStudent}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  Height="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Группа" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="Оценка" Binding="{Binding Grade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Таблица 2 (результат вставки):" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <DataGrid ItemsSource="{Binding SecondStudents}"
                                                  SelectedItem="{Binding SelectedSecondStudent}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  Height="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                                                <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="*"/>
                                                <DataGridTextColumn Header="Оценка" Binding="{Binding Grade}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ProgressBar" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <ProgressBar Value="20" Style="{StaticResource PrimaryProgressBarStyle}"/>
                                <ProgressBar Value="40" Style="{StaticResource AccentProgressBarStyle}"/>
                                <ProgressBar Value="100" Style="{StaticResource SuccessProgressBarStyle}"/>
                                <ProgressBar Value="60" Style="{StaticResource ErrorProgressBarStyle}"/>
                                <ProgressBar Value="80" Style="{StaticResource InfoProgressBarStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Всплывающие подсказки" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Button Content="Наведите курсор" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                                        ToolTip="Это простая всплывающая подсказка"/>
                                <TextBox Width="150" Text="Поле ввода"
                                         ToolTip="Подсказка для текстового поля"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Меню и контекстное меню" Margin="0,0,0,5">
                            <StackPanel Margin="10">
                                <Menu>
                                    <MenuItem Header="Файл">
                                        <MenuItem Header="Создать" Command="{Binding ShowActionMessageCommand}" CommandParameter="Меню: Создать"/>
                                        <MenuItem Header="Открыть" Command="{Binding ShowActionMessageCommand}" CommandParameter="Меню: Открыть"/>
                                        <Separator/>
                                        <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
                                    </MenuItem>
                                    <MenuItem Header="Правка">
                                        <MenuItem Header="Копировать строку таблицы" Command="{Binding CopyStudentCommand}"/>
                                        <MenuItem Header="Вставить во 2-ю таблицу" Command="{Binding PasteStudentCommand}"/>
                                    </MenuItem>
                                </Menu>

                                <Border Height="60" Margin="0,10,0,0" Background="{StaticResource Info500Brush}">
                                    <TextBlock Text="ПКМ для контекстного меню" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Копировать строку таблицы" Command="{Binding CopyStudentCommand}"/>
                                            <MenuItem Header="Вставить во 2-ю таблицу" Command="{Binding PasteStudentCommand}"/>
                                            <MenuItem Header="Удалить выбранную строку" Command="{Binding DeleteStudentCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Контейнеры компоновки">
                <ScrollViewer>
                    <WrapPanel Margin="10">
                        <GroupBox Header="StackPanel" Width="250" Height="200" Margin="5">
                            <StackPanel>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="WrapPanel" Width="250" Height="200" Margin="5">
                            <WrapPanel>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Error500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Info500Brush}" Margin="3"/>
                                <Rectangle Width="50" Height="25" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="DockPanel" Width="250" Height="200" Margin="5">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Top" Height="30" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle DockPanel.Dock="Bottom" Height="30" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle DockPanel.Dock="Left" Width="40" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Grid" Width="250" Height="200" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="UniformGrid" Width="250" Height="200" Margin="5">
                            <UniformGrid Rows="2" Columns="2">
                                <Rectangle Fill="{StaticResource Primary500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Accent500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Success500Brush}" Margin="3"/>
                                <Rectangle Fill="{StaticResource Error500Brush}" Margin="3"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="Canvas" Width="250" Height="200" Margin="5">
                            <Canvas>
                                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="80" Height="50" Fill="{StaticResource Primary500Brush}"/>
                                <Rectangle Canvas.Left="50" Canvas.Top="50" Width="80" Height="50" Fill="{StaticResource Accent500Brush}"/>
                                <Rectangle Canvas.Left="90" Canvas.Top="90" Width="80" Height="50" Fill="{StaticResource Success500Brush}"/>
                            </Canvas>
                        </GroupBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>