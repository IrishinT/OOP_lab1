                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Tr Loc_ShadesSuccess}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="60" Height="25" Fill="{StaticResource Success50Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="#E8F5E9" Width="90"/>
