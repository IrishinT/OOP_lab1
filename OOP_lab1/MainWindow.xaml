                                    <TextBlock Text="#1A237E" Width="90"/>
                                    <TextBlock Text="Primary 900"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Tr Loc_ShadesAccent}" Margin="0,0,0,10" Padding="10">
