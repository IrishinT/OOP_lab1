<Window x:Class="OOP_lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOP_lab1"
        mc:Ignorable="d"
        Title="Настройки приложения" Height="600" Width="1000">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Основное">
                <StackPanel Margin="10">

                    <GroupBox Header="Персонализация" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Тема интерфейса:" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ThemeBox" Margin="0,0,0,15" SelectedIndex="0">
                                <ComboBoxItem Content="Светлая (Light)"/>
                                <ComboBoxItem Content="Темная (Dark)"/>
                                <ComboBoxItem Content="Системная (System)"/>
                            </ComboBox>

                            <TextBlock Text="Язык интерфейса:" Margin="0,0,0,5"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Русский"/>
                                <ComboBoxItem Content="Белорусский"/>
                                <ComboBoxItem Content="Chinese"/>
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Deutch"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Настройки шрифтов" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Шрифт:" Margin="0,0,0,5"/>
                            <ComboBox Margin="0,0,0,15" SelectedIndex="0">
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Tahoma"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Calibri"/>
                                <ComboBoxItem Content="Times New Roman"/>
                            </ComboBox>

                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="Размер шрифта: "/>
                                <TextBlock Text="{Binding ElementName=FontSlider, Path=Value, StringFormat={}{0:0} pt}"/>

                                <Slider x:Name="FontSlider" 
                                        Minimum="10" 
                                        Maximum="24" 
                                        Value="14" 
                                        TickFrequency="1" 
                                        IsSnapToTickEnabled="True" 
                                        TickPlacement="BottomRight"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Цветовая палитра">
